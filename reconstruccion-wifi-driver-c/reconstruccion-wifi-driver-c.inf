;
; reconstruccion-wifi-driver-c.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = reconstruccion-wifi-driver-c.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
reconstruccion-wifi-driver-c.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%reconstruccion-wifi-driver-c.DeviceDesc% = reconstruccion-wifi-driver-c_Device, Root\reconstruccion-wifi-driver-c ; TODO: edit hw-id

[reconstruccion-wifi-driver-c_Device.NT]
CopyFiles = File_Copy

[File_Copy]
reconstruccion-wifi-driver-c.sys

;-------------- Service installation
[reconstruccion-wifi-driver-c_Device.NT.Services]
AddService = reconstruccion-wifi-driver-c,%SPSVCINST_ASSOCSERVICE%, reconstruccion-wifi-driver-c_Service_Inst

; -------------- reconstruccion-wifi-driver-c driver install sections
[reconstruccion-wifi-driver-c_Service_Inst]
DisplayName    = %reconstruccion-wifi-driver-c.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\reconstruccion-wifi-driver-c.sys

[reconstruccion-wifi-driver-c_Device.NT.Wdf]
KmdfService = reconstruccion-wifi-driver-c, reconstruccion-wifi-driver-c_wdfsect

[reconstruccion-wifi-driver-c_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "reconstruccion-wifi-driver-c Installation Disk"
reconstruccion-wifi-driver-c.DeviceDesc = "reconstruccion-wifi-driver-c Device"
reconstruccion-wifi-driver-c.SVCDESC = "reconstruccion-wifi-driver-c Service"
